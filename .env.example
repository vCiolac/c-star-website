# URL canônica do site (metadataBase, sitemap, robots, JSON-LD). Padrão: https://c-star.vercel.app
NEXT_PUBLIC_SITE_URL=https://c-star.vercel.app

# Versão jogável do MUFF (botões "Jogar"). Padrão: https://play-dev.muffoficial.com.br/
NEXT_PUBLIC_PLAY_URL=https://play-dev.muffoficial.com.br/

# ---- Formulário de contato (somente servidor; nunca use NEXT_PUBLIC_ aqui) ----
# Sem SMTP_HOST, SMTP_USER, SMTP_PASS e CONTACT_FORM_SECRET a API responde
# 503 {"error":"envio_indisponivel"} e a página mostra o e-mail oficial.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true para TLS implícito (465); false para STARTTLS (587). Padrão: true só se a porta for 465.
SMTP_SECURE=true
SMTP_USER=
# Para Gmail use uma "senha de app" (requer verificação em duas etapas).
SMTP_PASS=
# Destino das mensagens. Padrão: mufforigem@gmail.com
CONTACT_TO=mufforigem@gmail.com
# Remetente. Padrão: SMTP_USER. Ex.: "Site C-STAR <conta@dominio>"
CONTACT_FROM=
# Segredo longo e aleatório para assinar o token de tempo mínimo (HMAC-SHA256).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONTACT_FORM_SECRET=
